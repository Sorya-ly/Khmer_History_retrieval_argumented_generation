# Copy this file to `.env` and paste your real Gemini API key.
# The .env file is git-ignored and will NOT be committed.
#
#   1. Get a key at: https://aistudio.google.com/app/apikey
#   2. Create a file named `.env` next to this one.
#   3. Put the line below in it with your real key (no quotes needed):
#
GEMINI_API_KEY=your_api_key_here
